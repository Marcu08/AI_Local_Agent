{
  "workspace_roots": ["C:/Users/marzu/OneDrive/Desktop/agent_workspace"],
  "llm": {
    "provider": "ollama",
    "model": "llama3.1:8b",
    "base_url": "http://localhost:11434",
    "timeout_s": 120,
    "num_predict": 1024,
    "num_ctx": 8192
  },
  "security": {
    "require_write_confirmation": true,
    "require_command_confirmation": true,
    "command_blacklist": [
      "rm -rf",
      "rm -fr",
      "rmdir /s",
      "del /f",
      "format ",
      "mkfs",
      "dd if=",
      "shutdown",
      "Remove-Item -Recurse -Force"
    ],
    "command_allowlist": [
      {"command": "dir", "flags": ["/b"]},
      {"command": "ls", "flags": ["-l", "-a", "-la", "-1"]},
      {"command": "type"},
      {"command": "cat"},
      {"command": "git status", "flags": ["-s", "-b", "-sb"]},
      {
        "command": "git log",
        "flags": ["--stat", "--name-only", "--cached", "-n", "--oneline"]
      },
      {
        "command": "git diff",
        "flags": ["--stat", "--name-only", "--cached", "-n", "--oneline"]
      }
    ],
    "command_timeout_s": 30,
    "max_output_chars": 30000
  },
  "agent": {
    "max_iterations": 15,
    "max_tool_output_chars": 20000,
    "history_max_messages": 40,
    "history_max_chars": 50000
  }
}
